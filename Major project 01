import pandas as pd

# Load CSV file
df = pd.read_csv("employees.csv")

# Display data
print("Employee Data:")
print(df)

# Calculate average salary
average_salary = df["Salary"].mean()
print("\nAverage Salary:", average_salary)

# Count employees in each department
department_count = df["Department"].value_counts()
print("\nDepartment Count:")
print(department_count)

# Filter employees above salary threshold
threshold = 50000
high_salary = df[df["Salary"] > threshold]

print("\nEmployees with salary above", threshold)
print(high_salary)

# Export results to a new CSV
high_salary.to_csv("high_salary_employees.csv", index=False)

print("\nResults exported successfully!")
